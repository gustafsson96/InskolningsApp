@page "/admin/anvandare"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using OnboardingApp.Models
@using Microsoft.EntityFrameworkCore
@using OnboardingApp.Data
@using ModuleModel = OnboardingApp.Models.Module
@attribute [Authorize(Roles = "Admin")]

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<div class="admin-users-page">
    <div class="admin-page-header">
        <div>
            <h1>Hantera användare</h1>
            <p>Här kan administratörer skapa användare och hantera deras uppgifter.</p>
        </div>

        <button class="primary-button" @onclick="ToggleCreateForm">
            <i class="fa-solid fa-plus"></i>
            Ny användare
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="admin-message">@message</p>
    }

    @if (showCreateForm)
    {
        <CreateUserForm OnUserCreated="HandleUserCreated" OnCancel="HideCreateForm" OnMessage="SetMessage" />
    }

    <section class="admin-user-stats">
        <article class="admin-stat-card">
            <span class="stat-icon blue">
                <i class="fa-solid fa-users"></i>
            </span>
            <div>
                <p>Totalt användare</p>
                <strong>@users.Count</strong>
            </div>
        </article>

        <article class="admin-stat-card">
            <span class="stat-icon green">
                <i class="fa-solid fa-user-check"></i>
            </span>
            <div>
                <p>Medarbetare</p>
                <strong>@users.Count(u => GetEditForm(u.Id).Role == "Employee")</strong>
            </div>
        </article>

        <article class="admin-stat-card">
            <span class="stat-icon purple">
                <i class="fa-solid fa-user-shield"></i>
            </span>
            <div>
                <p>Administratörer</p>
                <strong>@users.Count(u => GetEditForm(u.Id).Role == "Admin")</strong>
            </div>
        </article>
    </section>

    <section class="admin-users-list-card">
        <div class="admin-section-header">
            <div>
                <h2>Befintliga användare</h2>
                <p>@users.Count användare registrerade i systemet</p>
            </div>
        </div>

        @if (users.Count == 0)
        {
            <p class="empty-text">Inga användare hittades.</p>
        }
        else
        {
            <div class="users-list">
                @foreach (var user in users)
                {
                    var form = GetEditForm(user.Id);

                    <article class="user-card">
                        <div class="user-card-top">
                            <div class="user-avatar">
                                @GetInitials(user)
                            </div>

                            <div class="user-summary">
                                <h3>@user.FirstName @user.LastName</h3>
                                <p>@user.Email</p>

                                <div class="user-meta">
                                    <span class="role-badge @(form.Role == "Admin" ? "admin" : "employee")">
                                        @(form.Role == "Admin" ? "Admin" : "Badpersonal")
                                    </span>

                                    @if (user.Startdate.HasValue)
                                    {
                                        <span>
                                            <i class="fa-regular fa-calendar"></i>
                                            Start: @user.Startdate.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="user-card-progress">
                                <div class="progress-header">
                                    <span class="status-badge @GetUserStatusClass(user.Id)">
                                        @GetUserStatus(user.Id)
                                    </span>

                                    <span class="progress-count">
                                        @GetCompletedModuleCount(user.Id) av @modules.Count moduler
                                    </span>
                                </div>

                                <div class="progress-track">
                                    <div class="progress-bar" style="width: @GetModuleProgressPercent(user.Id)%"></div>
                                </div>
                            </div>

                            <div class="user-actions">
                                <button class="secondary-button" @onclick="() => ToggleManagePanel(user.Id)">
                                    <i class="fa-solid fa-ellipsis"></i>
                                </button>
                            </div>
                        </div>

                        @if (activeUserPanelId == user.Id)
                        {
                            <div class="user-manage-panel">
                                <div class="manage-action-row">
                                    <button class="secondary-button" @onclick="() => ToggleDetails(user.Id)">
                                        <i class="fa-solid fa-chart-simple"></i>
                                        Modulstatus
                                    </button>

                                    <button class="secondary-button" @onclick="() => ToggleEditForm(user.Id)">
                                        <i class="fa-solid fa-pen"></i>
                                        Redigera uppgifter
                                    </button>

                                    <button class="danger-button" @onclick="() => DeleteUser(user.Id)">
                                        <i class="fa-solid fa-trash"></i>
                                        Ta bort användare
                                    </button>
                                </div>

                                @if (detailsUserId == user.Id)
                                {
                                    <div class="module-status-list">
                                        <h5>Modulstatus</h5>

                                        @foreach (var module in modules)
                                        {
                                            var completed = IsModuleCompleted(user.Id, module.ModuleId);

                                            <div class="module-status-bar-row">
                                                <div class="module-status-bar-header">
                                                    <span>@module.Title</span>
                                                    <strong>@(completed ? "Avklarad" : "Ej avklarad")</strong>
                                                </div>

                                                <div class="module-status-track">
                                                    <div class="module-status-fill @(completed ? "completed" : "not-completed")"
                                                         style="width: @(completed ? 100 : 0)%">
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (editingUserId == user.Id)
                                {
                                    <div class="user-edit-panel">
                                        <div class="user-edit-grid">
                                            <div class="form-field">
                                                <label>Förnamn</label>
                                                <input @bind="form.FirstName" />
                                            </div>

                                            <div class="form-field">
                                                <label>Efternamn</label>
                                                <input @bind="form.LastName" />
                                            </div>

                                            <div class="form-field">
                                                <label>E-post</label>
                                                <input @bind="form.Email" />
                                            </div>

                                            <div class="form-field">
                                                <label>Startdatum</label>
                                                <input type="date" @bind="form.Startdate" />
                                            </div>

                                            <div class="form-field">
                                                <label>Roll</label>
                                                <select @bind="form.Role">
                                                    <option value="Employee">Medarbetare</option>
                                                    <option value="Admin">Admin</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="user-edit-actions">
                                            <button class="secondary-button" @onclick="CloseEditForm">
                                                Avbryt
                                            </button>

                                            <button class="primary-button" @onclick="() => UpdateUser(user.Id)">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                                Spara ändringar
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>

@code {
    // Stores users from Identity
    private List<ApplicationUser> users = new();

    // Feedback message shown after create/update/delete
    private string? message;

    // Stores edit form data for each user
    private Dictionary<string, UserFormModel> editForms = new();

    private string? activeUserPanelId;
    private string? detailsUserId;
    private string? editingUserId;
    private List<ModuleModel> modules = new();
    private List<UserModuleProgress> moduleProgresses = new();

    // Form model when editing users
    private class UserFormModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public DateTime? Startdate { get; set; }
        public string Role { get; set; } = "Employee";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    // Show form to create new user
    private bool showCreateForm;

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
    }

    // Hide form to create new user
    private void HideCreateForm()
    {
        showCreateForm = false;
    }

    // Refresh user list after a new user has been created
    private async Task HandleUserCreated()
    {
        showCreateForm = false;
        await LoadUsers();
    }

    private void SetMessage(string newMessage)
    {
        message = newMessage;
    }

    // Get initals to display in list
    private string GetInitials(ApplicationUser user)
    {
        var first = string.IsNullOrWhiteSpace(user.FirstName) ? "" : user.FirstName[0].ToString();
        var last = string.IsNullOrWhiteSpace(user.LastName) ? "" : user.LastName[0].ToString();

        return $"{first}{last}".ToUpper();
    }

    // Toggle options for a user
    private void ToggleManagePanel(string userId)
    {
        activeUserPanelId = activeUserPanelId == userId ? null : userId;

        if (activeUserPanelId != userId)
        {
            detailsUserId = null;
            editingUserId = null;
        }
    }

    // Toggle detailed progress overview
    private void ToggleDetails(string userId)
    {
        detailsUserId = detailsUserId == userId ? null : userId;
        editingUserId = null;
    }

    private bool IsModuleCompleted(string userId, int moduleId)
    {
        return moduleProgresses.Any(p =>
            p.UserId == userId &&
            p.ModuleId == moduleId &&
            p.IsCompleted);
    }

    // Returns number of completed modules for a user
    private int GetCompletedModuleCount(string userId)
    {
        return moduleProgresses.Count(p =>
            p.UserId == userId &&
            p.IsCompleted);
    }

    // Returns progress percentage for a user
    private int GetModuleProgressPercent(string userId)
    {
        if (modules.Count == 0)
        {
            return 0;
        }

        return (int)Math.Round(
            (double)GetCompletedModuleCount(userId) / modules.Count * 100
        );
    }

    // Returns onboarding status class
    private string GetUserStatusClass(string userId)
    {
        var completed = GetCompletedModuleCount(userId);

        if (completed == 0)
        {
            return "not-started";
        }

        if (completed == modules.Count)
        {
            return "completed";
        }

        return "in-progress";
    }

    // Returns onboarding status label
    private string GetUserStatus(string userId)
    {
        var completed = GetCompletedModuleCount(userId);

        if (completed == 0)
        {
            return "Ej påbörjad";
        }

        if (completed == modules.Count)
        {
            return "Avklarad";
        }

        return "Påbörjad";
    }

    // Loads all users and prepares edit forms
    private async Task LoadUsers()
    {
        users = UserManager.Users
            .OrderBy(u => u.FirstName)
            .ThenBy(u => u.LastName)
            .ToList();

        editForms.Clear();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);

            editForms[user.Id] = new UserFormModel
            {
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email ?? string.Empty,
                Startdate = user.Startdate,
                Role = roles.FirstOrDefault() ?? "Employee"
            };
        }

        modules = await Db.Modules
            .OrderBy(m => m.OrderIndex)
            .ToListAsync();

        moduleProgresses = await Db.UserModuleProgresses
            .ToListAsync();
    }

    // Returns the edit form for a selected user
    private UserFormModel GetEditForm(string userId)
    {
        if (!editForms.ContainsKey(userId))
        {
            editForms[userId] = new UserFormModel();
        }

        return editForms[userId];
    }

    // Open edit user form
    private void ToggleEditForm(string userId)
    {
        editingUserId = editingUserId == userId ? null : userId;
    }

    // Close edit user form
    private void CloseEditForm()
    {
        editingUserId = null;
    }

    // Updates user details and role
    private async Task UpdateUser(string userId)
    {
        var form = GetEditForm(userId);

        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.Email))
        {
            message = "Förnamn, efternamn och e-post måste anges.";
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);

        if (user is null)
        {
            message = "Användaren kunde inte hittas.";
            return;
        }

        user.FirstName = form.FirstName;
        user.LastName = form.LastName;
        user.Email = form.Email;
        user.UserName = form.Email;
        user.Startdate = form.Startdate;

        var updateResult = await UserManager.UpdateAsync(user);

        if (!updateResult.Succeeded)
        {
            message = string.Join(" ", updateResult.Errors.Select(e => e.Description));
            return;
        }

        var currentRoles = await UserManager.GetRolesAsync(user);

        if (currentRoles.Any())
        {
            await UserManager.RemoveFromRolesAsync(user, currentRoles);
        }

        await UserManager.AddToRoleAsync(user, form.Role);

        message = "Användaren uppdaterades.";

        await LoadUsers();

        editingUserId = null;
    }

    // Deletes a user from Identity
    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);

        if (user is null)
        {
            message = "Användaren kunde inte hittas.";
            return;
        }

        var result = await UserManager.DeleteAsync(user);

        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        message = "Användaren togs bort.";

        await LoadUsers();
    }
}