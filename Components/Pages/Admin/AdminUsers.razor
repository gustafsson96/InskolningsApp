@page "/admin/anvandare"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using OnboardingApp.Models
@attribute [Authorize(Roles = "Admin")]

@inject UserManager<ApplicationUser> UserManager

<div class="admin-users-page">
    <div class="admin-page-header">
        <div>
            <h1>Hantera användare</h1>
            <p>Här kan administratörer skapa användare och hantera deras uppgifter.</p>
        </div>
        <button class="primary-button" @onclick="ToggleCreateForm">
            <i class="fa-solid fa-plus"></i>
            Ny användare
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="admin-message">@message</p>
    }

    @if (showCreateForm)
    {
        <CreateUserForm OnUserCreated="HandleUserCreated" OnCancel="HideCreateForm" OnMessage="SetMessage" />
    }

    <section>
        <h2>Befintliga användare</h2>

        @if (users.Count == 0)
        {
            <p>Inga användare hittades.</p>
        }
        else
        {
            @foreach (var user in users)
            {
                var form = GetEditForm(user.Id);

                <div style="border:1px solid #ddd; padding:1em; margin-bottom:1em;">
                    <h3>@user.FirstName @user.LastName</h3>
                    <p><strong>E-post:</strong> @user.Email</p>

                    <div>
                        <label>Förnamn</label><br />
                        <input @bind="form.FirstName" />
                    </div>

                    <div style="margin-top:0.5em;">
                        <label>Efternamn</label><br />
                        <input @bind="form.LastName" />
                    </div>

                    <div style="margin-top:0.5em;">
                        <label>E-post</label><br />
                        <input @bind="form.Email" />
                    </div>

                    <div style="margin-top:0.5em;">
                        <label>Startdatum</label><br />
                        <input type="date" @bind="form.Startdate" />
                    </div>

                    <div style="margin-top:0.5em;">
                        <label>Roll</label><br />
                        <select @bind="form.Role">
                            <option value="Employee">Employee</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>

                    <div style="margin-top:0.75em;">
                        <button @onclick="() => UpdateUser(user.Id)">Spara ändringar</button>
                        <button @onclick="() => DeleteUser(user.Id)">Ta bort</button>
                    </div>
                </div>
            }
        }
    </section>
</div>

@code {
    // Stores users from Identity
    private List<ApplicationUser> users = new();

    // Feedback message shown after create/update/delete
    private string? message;

    // Stores edit form data for each user
    private Dictionary<string, UserFormModel> editForms = new();

    // Form model when editing users
    private class UserFormModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public DateTime? Startdate { get; set; }
        public string Role { get; set; } = "Employee";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    // Show form to create new user
    private bool showCreateForm;

    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
    }

    // Hide form to create new user
    private void HideCreateForm()
    {
        showCreateForm = false;
    }

    // Refresh user list after a new user has been created
    private async Task HandleUserCreated()
    {
        showCreateForm = false;
        await LoadUsers();
    }

    private void SetMessage(string newMessage)
    {
        message = newMessage;
    }

    private string GetInitials(ApplicationUser user)
    {
        var first = string.IsNullOrWhiteSpace(user.FirstName) ? "" : user.FirstName[0].ToString();
        var last = string.IsNullOrWhiteSpace(user.LastName) ? "" : user.LastName[0].ToString();

        return $"{first}{last}".ToUpper();
    }

    // Loads all users and prepares edit forms
    private async Task LoadUsers()
    {
        users = UserManager.Users
            .OrderBy(u => u.FirstName)
            .ThenBy(u => u.LastName)
            .ToList();

        editForms.Clear();

        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);

            editForms[user.Id] = new UserFormModel
            {
                FirstName = user.FirstName,
                LastName = user.LastName,
                Email = user.Email ?? string.Empty,
                Startdate = user.Startdate,
                Role = roles.FirstOrDefault() ?? "Employee"
            };
        }
    }

    // Returns the edit form for a selected user
    private UserFormModel GetEditForm(string userId)
    {
        if (!editForms.ContainsKey(userId))
        {
            editForms[userId] = new UserFormModel();
        }

        return editForms[userId];
    }

    // Updates user details and role
    private async Task UpdateUser(string userId)
    {
        var form = GetEditForm(userId);

        if (string.IsNullOrWhiteSpace(form.FirstName) ||
            string.IsNullOrWhiteSpace(form.LastName) ||
            string.IsNullOrWhiteSpace(form.Email))
        {
            message = "Förnamn, efternamn och e-post måste anges.";
            return;
        }

        var user = await UserManager.FindByIdAsync(userId);

        if (user is null)
        {
            message = "Användaren kunde inte hittas.";
            return;
        }

        user.FirstName = form.FirstName;
        user.LastName = form.LastName;
        user.Email = form.Email;
        user.UserName = form.Email;
        user.Startdate = form.Startdate;

        var updateResult = await UserManager.UpdateAsync(user);

        if (!updateResult.Succeeded)
        {
            message = string.Join(" ", updateResult.Errors.Select(e => e.Description));
            return;
        }

        var currentRoles = await UserManager.GetRolesAsync(user);

        if (currentRoles.Any())
        {
            await UserManager.RemoveFromRolesAsync(user, currentRoles);
        }

        await UserManager.AddToRoleAsync(user, form.Role);

        message = "Användaren uppdaterades.";

        await LoadUsers();
    }

    // Deletes a user from Identity
    private async Task DeleteUser(string userId)
    {
        var user = await UserManager.FindByIdAsync(userId);

        if (user is null)
        {
            message = "Användaren kunde inte hittas.";
            return;
        }

        var result = await UserManager.DeleteAsync(user);

        if (!result.Succeeded)
        {
            message = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        message = "Användaren togs bort.";

        await LoadUsers();
    }
}