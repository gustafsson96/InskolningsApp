@using Microsoft.EntityFrameworkCore
@using OnboardingApp.Data

@inject ApplicationDbContext Db

@if (unreadCount > 0)
{
    <section class="admin-notification-panel">
        <div class="notification-summary">
            <div>
                <h2>Notiser</h2>
                <p>@unreadCount olästa notiser</p>
            </div>

            <div class="notification-actions">

                @if (showNotifications)
                {
                    <button class="secondary-button danger" @onclick="MarkAllAsRead">
                        Markera alla som lästa
                    </button>
                }

                <button class="primary-button" @onclick="ToggleNotifications">
                    @(showNotifications ? "Dölj notiser" : "Visa notiser")
                </button>

            </div>
        </div>

        @if (showNotifications)
        {
            <div class="notification-list">
                @foreach (var notification in notifications)
                {
                    <article class="notification-item">
                        <div>
                            <h3>@notification.Title</h3>
                            <p>@notification.Message</p>
                        </div>

                        <button class="notification-dismiss" title="Markera som läst" @onclick="() => MarkAsRead(notification)">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    // Stores unread notifications shown in the panel
    private List<OnboardingApp.Models.AdminNotification> notifications = new();

    // Controls if the notification list is expanded or hidden
    private bool showNotifications = false;

    // Number of unread notifications
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
    }

    // Loads unread notifications
    private async Task LoadNotifications()
    {
        notifications = await Db.AdminNotifications
            .Where(n => !n.IsRead)
            .OrderBy(n => n.DueDate)
            .ToListAsync();

        unreadCount = notifications.Count;
    }

    // Shows or hides the notification list
    private void ToggleNotifications()
    {
        showNotifications = !showNotifications;
    }

    // Marks one notification as read
    private async Task MarkAsRead(OnboardingApp.Models.AdminNotification notification)
    {
        notification.IsRead = true;

        await Db.SaveChangesAsync();

        await LoadNotifications();

        if (unreadCount == 0)
        {
            showNotifications = false;
        }
    }

    // Marks all unread notifications as read
    private async Task MarkAllAsRead()
    {
        foreach (var notification in notifications)
        {
            notification.IsRead = true;
        }

        await Db.SaveChangesAsync();

        notifications.Clear();
        unreadCount = 0;
        showNotifications = false;
    }
}