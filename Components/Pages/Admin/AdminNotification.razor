@using Microsoft.EntityFrameworkCore
@using OnboardingApp.Data
@using OnboardingApp.Models

@inject ApplicationDbContext Db

<section class="admin-notification-panel">
    <div class="notification-panel-header">
        <div>
            <h2>Notiser</h2>
            <p>Påminnelser kopplade till inskolning.</p>
        </div>

        <span class="notification-count">@unreadCount</span>
    </div>

    @if (notifications.Count == 0)
    {
        <p class="empty-notifications">Inga notiser just nu.</p>
    }
    else
    {
        <div class="notification-list">
            @foreach (var notification in notifications)
            {
                <article class="notification-item @(notification.IsRead ? "read" : "unread")">
                    <div>
                        <h3>@notification.Title</h3>
                        <p>@notification.Message</p>
                        <small>Förfaller: @notification.DueDate.ToString("yyyy-MM-dd")</small>
                    </div>
                    <button class="notification-dismiss" title="Markera som läst" @onclick="() => MarkAsRead(notification)">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </article>
            }
        </div>
    }
</section>

@code {
    // Stores the latest notifications shown in panel
    private List<OnboardingApp.Models.AdminNotification> notifications = new();

    // Unread notifications
    private int unreadCount;

    protected override async Task OnInitializedAsync()
    {
        // Load the latest notifications
        notifications = await Db.AdminNotifications
            .Where(n => !n.IsRead)
            .OrderBy(n => n.DueDate)
            .Take(5)
            .ToListAsync();

        // Count unread notifications
        unreadCount = notifications.Count(n => !n.IsRead);
    }

    // Mark a notification as read when x-button is clicked
    private async Task MarkAsRead(OnboardingApp.Models.AdminNotification notification)
    {
        notification.IsRead = true;

        await Db.SaveChangesAsync();

        notifications.Remove(notification);
        unreadCount = notifications.Count(n => !n.IsRead);
    }
}