@page "/admin/moduler"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using OnboardingApp.Data
@using OnboardingApp.Models
@attribute [Authorize(Roles = "Admin")]
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<div class="admin-modules-page">
    <div class="admin-page-header">
        <div>
            <h1>Hantera moduler</h1>
            <p>Endast administratörer kan visa denna sida.</p>
        </div>

        <button class="primary-button" @onclick="ToggleCreateForm">
            <i class="fa-solid fa-plus"></i>
            Ny modul
        </button>
    </div>

    @if (showCreateForm)
    {
        <section class="admin-form-card">
            <h2>Skapa ny modul</h2>

            @if (!string.IsNullOrWhiteSpace(createModuleMessage))
            {
                <div class="admin-alert">
                    <span>@createModuleMessage</span>

                    <button class="alert-close-button" @onclick="ClearCreateModuleMessage">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            }

            <div class="form-group">
                <label for="title">Titel</label>
                <input id="title" @bind="newModule.Title" />
            </div>

            <div class="form-group">
                <label for="description">Beskrivning</label>
                <textarea id="description" @bind="newModule.Description"></textarea>
            </div>

            <div class="form-actions">
                <button class="primary-button" @onclick="CreateModule">Skapa modul</button>
                <button class="secondary-button" @onclick="ToggleCreateForm">Avbryt</button>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(moduleListMessage))
    {
        <div class="admin-alert">
            <span>@moduleListMessage</span>

            <button class="alert-close-button" @onclick="ClearModuleListMessage">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (modules.Count == 0)
    {
        <p>Det finns inga moduler ännu.</p>
    }
    else
    {
        <div class="module-list">
            @foreach (var module in modules)
            {
                var sectionForm = GetSectionForm(module.ModuleId);

                <div class="module-admin-card">
                    @if (editingModuleId == module.ModuleId)
                    {
                        <div class="edit-module-form">
                            <div class="form-group">
                                <label>Titel</label>
                                <input @bind="editModule.Title" />
                            </div>

                            <div class="form-group">
                                <label>Beskrivning</label>
                                <textarea @bind="editModule.Description"></textarea>
                            </div>

                            <div class="form-actions">
                                <button class="primary-button" @onclick="SaveEdit">Spara</button>
                                <button class="secondary-button" @onclick="CancelEdit">Avbryt</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="module-card-top">
                            <div class="module-title-row">
                                <span class="module-order">@module.OrderIndex</span>
                                <div>
                                    <h2>@module.Title</h2>
                                    <p>@module.Description</p>
                                </div>
                            </div>
                            <div class="module-actions">
                                <button class="icon-button" title="Redigera" @onclick="() => StartEdit(module)">
                                    <i class="fa-regular fa-pen-to-square"></i>
                                </button>

                                <button class="icon-button danger" title="Ta bort" @onclick="() => AskDeleteModule(module)">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </div>

                        @if (moduleIdPendingDelete == module.ModuleId)
                        {
                            <div class="delete-confirm-box">
                                <p>
                                    Vill du radera <strong>@moduleTitlePendingDelete</strong>?
                                    Alla sektioner och quizfrågor kopplade till modulen tas också bort.
                                </p>

                                <div class="delete-confirm-actions">
                                    <button class="secondary-button" @onclick="CancelDeleteModule">
                                        Avbryt
                                    </button>

                                    <button class="danger-button" @onclick="ConfirmDeleteModule">
                                        Ja, radera modul
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="module-meta">
                            <span>
                                <i class="fa-regular fa-file-lines"></i>
                                @(module.Sections?.Count ?? 0) sektioner
                            </span>

                            <span>
                                <i class="fa-regular fa-circle-question"></i>
                                @module.QuizQuestions.Count quizfrågor
                            </span>
                        </div>

                        <div class="module-card-links">
                            <button class="secondary-button add-section-button" @onclick="() => ToggleSectionForm(module.ModuleId)">
                                <i class="fa-solid fa-plus"></i>
                                Lägg till sektion
                            </button>
                            <button class="secondary-button" @onclick='() => Nav.NavigateTo($"/admin/quiz/{module.ModuleId}")'>
                                Hantera quiz
                            </button>
                        </div>
                    }
                    @if (openSectionFormId == module.ModuleId)
                    {
                        <div class="add-section-details">
                            @if (!string.IsNullOrWhiteSpace(sectionMessage))
                            {
                                <div class="admin-alert">
                                    <span>@sectionMessage</span>

                                    <button class="alert-close-button" @onclick="ClearSectionMessage">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                            }
                            <div class="section-form">
                                <div class="form-group">
                                    <label>Titel</label>
                                    <input @bind="sectionForm.Title" />
                                </div>

                                <div class="form-group">
                                    <RichTextEditor @key="module.ModuleId" @ref="sectionEditor" @bind-Value="sectionForm.Content"
                                                    AllowImages="true" />
                                </div>

                                <div class="form-actions">
                                    <button class="primary-button" @onclick="() => CreateSection(module.ModuleId)">
                                        Spara
                                    </button>

                                    <button class="secondary-button" @onclick="() => ToggleSectionForm(module.ModuleId)">
                                        Avbryt
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="sections-area">
                        <div class="sections-header">
                            <button type="button" class="text-button" @onclick="() => ToggleSections(module.ModuleId)">
                                @(expandedSections.Contains(module.ModuleId) ? "Dölj modulens sektioner" : "Visa modulens sektioner")
                            </button>
                        </div>
                        @if (expandedSections.Contains(module.ModuleId))
                        {
                            @if (module.Sections == null || !module.Sections.Any())
                            {
                                <p class="empty-text">Inga sektioner ännu.</p>
                            }
                            else
                            {
                                <div class="section-list compact">
                                    @foreach (var moduleSection in module.Sections.OrderBy(s => s.OrderIndex))
                                    {
                                        <button class="section-item section-link"
                                                @onclick="() => GoToSection(moduleSection.ModuleSectionId)">
                                            <span>@moduleSection.OrderIndex</span>
                                            <strong>@moduleSection.Title</strong>
                                            <i class="fa-solid fa-chevron-right"></i>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Module> modules = new();
    private Module newModule = new();
    private int? editingModuleId;
    private Module editModule = new();
    private string? createModuleMessage;
    private string? moduleListMessage;
    private string? sectionMessage;
    private bool showCreateForm = false;
    private int? openSectionFormId;
    private HashSet<int> expandedSections = new();
    private RichTextEditor? sectionEditor;
    private int? moduleIdPendingDelete;
    private string? moduleTitlePendingDelete;

    // View model for a new section
    private class NewSectionModel
    {
        public string Title { get; set; } = string.Empty;
        public string Content { get; set; } = string.Empty;
    }

    // Section form for each module
    private Dictionary<int, NewSectionModel> newSections = new();

    // Fetch modules on page load
    protected override async Task OnInitializedAsync()
    {
        await LoadModules();
    }

    // Load all modules from db
    private async Task LoadModules()
    {
        modules = await Db.Modules
            .Include(m => m.Sections)
            .Include(m => m.QuizQuestions)
            .OrderBy(m => m.OrderIndex)
            .ToListAsync();
    }

    // Show or hide create module form
    private void ToggleCreateForm()
    {
        showCreateForm = !showCreateForm;
        newModule = new Module();
    }

    // Create module
    private async Task CreateModule()
    {
        if (string.IsNullOrWhiteSpace(newModule.Title))
        {
            createModuleMessage = "Titel måste anges.";
            return;
        }

        int maxOrderIndex = await Db.Modules
            .MaxAsync(m => (int?)m.OrderIndex) ?? 0;

        var module = new Module
        {
            Title = newModule.Title,
            Description = newModule.Description,
            OrderIndex = maxOrderIndex + 1
        };

        Db.Modules.Add(module);
        await Db.SaveChangesAsync();

        newModule = new Module();
        showCreateForm = false;
        createModuleMessage = "Modulen skapades.";

        await LoadModules();
    }

    // Edit module
    private void StartEdit(Module module)
    {
        editingModuleId = module.ModuleId;

        editModule = new Module
        {
            ModuleId = module.ModuleId,
            Title = module.Title,
            Description = module.Description,
            OrderIndex = module.OrderIndex
        };
    }

    // Save edited module
    private async Task SaveEdit()
    {
        var module = await Db.Modules.FindAsync(editModule.ModuleId);

        if (module is null)
        {
            moduleListMessage = "Modulen kunde inte hittas.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editModule.Title))
        {
            moduleListMessage = "Titel måste anges.";
            return;
        }

        module.Title = editModule.Title;
        module.Description = editModule.Description;
        module.OrderIndex = editModule.OrderIndex;

        await Db.SaveChangesAsync();

        editingModuleId = null;
        editModule = new Module();
        moduleListMessage = "Modulen uppdaterades.";

        await LoadModules();
    }

    // Cancel edit
    private void CancelEdit()
    {
        editingModuleId = null;
        editModule = new Module();
    }

    // Open delete confirmation for a module
    private void AskDeleteModule(Module module)
    {
        moduleIdPendingDelete = module.ModuleId;
        moduleTitlePendingDelete = module.Title;
    }

    // Cancel module deletion
    private void CancelDeleteModule()
    {
        moduleIdPendingDelete = null;
        moduleTitlePendingDelete = null;
    }

    // Deletes the selected module after confirmation
    private async Task ConfirmDeleteModule()
    {
        if (moduleIdPendingDelete is null)
        {
            return;
        }

        await DeleteModule(moduleIdPendingDelete.Value);

        moduleIdPendingDelete = null;
        moduleTitlePendingDelete = null;
    }

    // Delete a module and its sections
    private async Task DeleteModule(int moduleId)
    {
        var module = await Db.Modules
            .Include(m => m.Sections)
            .Include(m => m.QuizQuestions)
                .ThenInclude(q => q.Options)
            .FirstOrDefaultAsync(m => m.ModuleId == moduleId);

        if (module is null)
        {
            moduleListMessage = "Modulen kunde inte hittas.";
            return;
        }

        var questionIds = module.QuizQuestions
            .Select(q => q.QuizQuestionId)
            .ToList();

        var optionIds = module.QuizQuestions
            .SelectMany(q => q.Options)
            .Select(o => o.QuizOptionId)
            .ToList();

        var attempts = await Db.QuizAttempts
            .Where(a => a.ModuleId == moduleId)
            .ToListAsync();

        var attemptIds = attempts
            .Select(a => a.QuizAttemptId)
            .ToList();

        var answers = await Db.QuizAnswers
            .Where(a =>
                attemptIds.Contains(a.QuizAttemptId) ||
                questionIds.Contains(a.QuizQuestionId) ||
                optionIds.Contains(a.SelectedOptionId))
            .ToListAsync();

        Db.QuizAnswers.RemoveRange(answers);
        Db.QuizAttempts.RemoveRange(attempts);

        if (module.Sections.Any())
        {
            Db.ModuleSections.RemoveRange(module.Sections);
        }

        if (module.QuizQuestions.Any())
        {
            Db.QuizQuestions.RemoveRange(module.QuizQuestions);
        }

        Db.Modules.Remove(module);

        await Db.SaveChangesAsync();

        moduleListMessage = "Modulen, dess sektioner och quizdata togs bort.";
        await LoadModules();
    }

    // Get formdata for a module
    private NewSectionModel GetSectionForm(int moduleId)
    {
        if (!newSections.ContainsKey(moduleId))
        {
            newSections[moduleId] = new NewSectionModel();
        }
        return newSections[moduleId];
    }

    // Toggle sections
    private void ToggleSections(int moduleId)
    {
        if (expandedSections.Contains(moduleId))
        {
            expandedSections.Remove(moduleId);
        }
        else
        {
            expandedSections.Add(moduleId);
        }
    }

    // Navigate to a specific section
    private void GoToSection(int sectionId)
    {
        Nav.NavigateTo($"/admin/sektioner/{sectionId}");
    }

    // Open/close section from
    private void ToggleSectionForm(int moduleId)
    {
        openSectionFormId = openSectionFormId == moduleId ? null : moduleId;
    }

    // Create a new section for a module
    private async Task CreateSection(int moduleId)
    {
        var form = GetSectionForm(moduleId);

        // Sync current Quill content to the section form model
        if (sectionEditor is not null)
        {
            await sectionEditor.UpdateValue();
        }

        if (string.IsNullOrWhiteSpace(form.Title) || string.IsNullOrWhiteSpace(form.Content))
        {
            sectionMessage = "Sektionens titel och innehåll måste anges.";
            return;
        }

        int maxOrderIndex = await Db.ModuleSections
            .Where(s => s.ModuleId == moduleId)
            .MaxAsync(s => (int?)s.OrderIndex) ?? 0;

        var section = new ModuleSection
        {
            ModuleId = moduleId,
            Title = form.Title,
            Content = form.Content,
            OrderIndex = maxOrderIndex + 1
        };

        Db.ModuleSections.Add(section);
        await Db.SaveChangesAsync();

        newSections[moduleId] = new NewSectionModel();
        sectionEditor = null;
        openSectionFormId = null;
        sectionMessage = "Sektionen skapades.";

        await LoadModules();
    }

    private void ClearCreateModuleMessage()
    {
        createModuleMessage = null;
    }

    private void ClearModuleListMessage()
    {
        moduleListMessage = null;
    }

    private void ClearSectionMessage()
    {
        sectionMessage = null;
    }
}