@page "/dashboard"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OnboardingApp.Data
@using OnboardingApp.Models
@using ModuleModel = OnboardingApp.Models.Module
@attribute [Authorize]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

@if (isLoading)
{
    <p>Laddar dashboard...</p>
}
else
{
    <h1>
        Välkommen@(string.IsNullOrWhiteSpace(firstName) ? "" : $", {firstName}")!
    </h1>
    @* Overview cards for modules *@
    <ModuleOverview TotalModules="@totalModules" CompletedModules="@completedModules"
                    RemainingModules="@remainingModules" />
    @* Checklist status overview *@
    <ProgressBar Total="@totalChecklistItems" Completed="@completedChecklistItems" />
    @* List of module cards *@
    <ModuleCards Modules="@modules" UserProgresses="@moduleProgresses" />
}

@code {
    private bool isLoading = true;

    // Store name of user
    private string? firstName;

    // Module overview values
    private int totalModules;
    private int completedModules;
    private int remainingModules;

    // Checklist values
    private int totalChecklistItems;
    private int completedChecklistItems;

    // Data used for rendering module cards
    private List<ModuleModel> modules = new();
    private List<UserModuleProgress> moduleProgresses = new();

    protected override async Task OnInitializedAsync()
    {
        // Get authentication state and current user
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Stop if user is not authenticated
        if (user.Identity?.IsAuthenticated != true)
        {
            isLoading = false;
            return;
        }

        // Get user id
        string? userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            isLoading = false;
            return;
        }

        await using var Db = await DbFactory.CreateDbContextAsync();

        // Fetch full user from database
        var appUser = await Db.Users
            .FirstOrDefaultAsync(u => u.Id == userId);

        firstName = appUser?.FirstName;

        // Count all modules
        totalModules = await Db.Modules.CountAsync();

        // Count completed modules
        completedModules = await Db.UserModuleProgresses
            .CountAsync(x => x.UserId == userId && x.IsCompleted);

        remainingModules = totalModules - completedModules;

        // Count checklist items
        totalChecklistItems = await Db.ChecklistItems.CountAsync();

        // Count completed checklist items
        completedChecklistItems = await Db.UserChecklistItemStatus
            .CountAsync(x => x.UserId == userId && x.Status == ChecklistStatus.Completed);

        // Load modules
        modules = await Db.Modules
            .OrderBy(m => m.OrderIndex)
            .ToListAsync();

        // Load user's module progress
        moduleProgresses = await Db.UserModuleProgresses
            .Where(x => x.UserId == userId)
            .ToListAsync();

        isLoading = false;
    }
}