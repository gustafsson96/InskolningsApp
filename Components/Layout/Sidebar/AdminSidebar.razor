@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav


<div class="admin-sidebar">
    <div class="admin-sidebar-top">
        <div class="admin-header">
        <!-- Title -->
            <h2>Adminpanel</h2>
            <p>Introduktionshantering</p>
        </div>

        <!-- Admin links -->
        <nav class="admin-nav">
            <NavLink href="/admin"
                     class="admin-link"
                     ActiveClass="active"
                     Match="NavLinkMatch.All">
                <span class="admin-icon">▣</span>
                <span>Översikt</span>
            </NavLink>

            <NavLink href="/admin/checklista"
                     class="admin-link"
                     ActiveClass="active">
                <span class="admin-icon">✓</span>
                <span>Checklista</span>
            </NavLink>

            <NavLink href="/admin/moduler"
                     class="admin-link"
                     ActiveClass="active">
                <span class="admin-icon">≣</span>
                <span>Moduler & quiz</span>
            </NavLink>

            <NavLink href="/admin/anvandare"
                     class="admin-link"
                     ActiveClass="active">
                <span class="admin-icon">◉</span>
                <span>Användarhantering</span>
            </NavLink>
        </nav>
    </div>

    <!-- Actions -->
    <div class="admin-sidebar-bottom">
        <button class="admin-btn back-btn" @onclick="GoBack">
            ← Visa användarvy
        </button>
            <form method="post" action="/logout">
                <button type="submit" class="admin-btn logout-btn">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logga ut
                </button>
            </form>
    </div>
</div>

@code {
    private void GoBack()
    {
        Nav.NavigateTo("/dashboard");
    }
}