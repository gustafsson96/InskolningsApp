@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject IWebHostEnvironment Environment

<div class="rich-text-editor-wrapper">
    <!-- Quill editor container -->
    <div id="@editorId" class="quill-editor"></div>

    <div class="rich-text-actions">
        @if (AllowImages)
        {
            <label class="image-upload-button">
                <i class="fa-regular fa-image"></i>
                Lägg till bild
                <InputFile class="hidden-file-input" OnChange="UploadImage" accept="image/*" />
            </label>

        }

        <button type="button" class="video-button" @onclick="ToggleVideoPopup">
            <i class="fa-brands fa-youtube"></i>
            Lägg till video
        </button>
    </div>
</div>

@if (showVideoPopup)
{
    <div class="video-popup-overlay">
        <div class="video-popup">

            <div class="video-popup-header">
                <h3>Lägg till YouTube-video</h3>

                <button type="button" class="close-popup-button" @onclick="ToggleVideoPopup">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <input @bind="youtubeUrl" placeholder="Klistra in YouTube-länk" class="youtube-input" />

            <div class="video-popup-actions">
                <button type="button" class="secondary-button" @onclick="ToggleVideoPopup">
                    Avbryt
                </button>

                <button type="button" class="primary-button" @onclick="InsertYoutubeVideo">
                    Infoga video
                </button>
            </div>

        </div>
    </div>
}

@code {
    // Current editor value (HTML)
    [Parameter]
    public string Value { get; set; } = string.Empty;

    // Enables two-way binding
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    // Toggle image upload support
    [Parameter]
    public bool AllowImages { get; set; } = true;

    // Unique id for the Quill instance
    private readonly string editorId = $"editor-{Guid.NewGuid()}";

    // Youtube url
    private string youtubeUrl = string.Empty;
    
    // Controls if the video popup is visible
    private bool showVideoPopup = false;

    // Create Quill editor after component has rendered
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync(
                "quillEditor.create",
                editorId,
                Value ?? ""
            );
        }
    }

    // Fetch current HTML content from Quill
    public async Task UpdateValue()
    {
        var html = await JS.InvokeAsync<string>(
            "quillEditor.getHtml",
            editorId
        );

        Value = html;

        await ValueChanged.InvokeAsync(html);
    }

    // Upload image and insert into editor
    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file is null)
        {
            return;
        }

        // Create uploads folder if it does not exist
        var uploadsFolder = Path.Combine(
            Environment.WebRootPath,
            "uploads",
            "sections"
        );

        Directory.CreateDirectory(uploadsFolder);

        // Generate unique filename
        var extension = Path.GetExtension(file.Name);
        var fileName = $"{Guid.NewGuid()}{extension}";
        var filePath = Path.Combine(uploadsFolder, fileName);

        // Save uploaded file
        await using var stream = file.OpenReadStream(
            maxAllowedSize: 5 * 1024 * 1024
        );

        await using var fileStream = File.Create(filePath);

        await stream.CopyToAsync(fileStream);

        // Public image url
        var imageUrl = $"/uploads/sections/{fileName}";

        // Insert image into Quill editor
        await JS.InvokeVoidAsync(
            "quillEditor.insertImage",
            editorId,
            imageUrl
        );
    }

    // Insert YouTube video into editor
    private async Task InsertYoutubeVideo()
    {
        if (string.IsNullOrWhiteSpace(youtubeUrl))
        {
            return;
        }

        await JS.InvokeVoidAsync(
            "quillEditor.insertYoutube",
            editorId,
            youtubeUrl
        );

        youtubeUrl = string.Empty;

        // Hide popup after insert
        showVideoPopup = false;
    }

    // Shows or hides the video popup
    private void ToggleVideoPopup()
    {
        showVideoPopup = !showVideoPopup;
    }
}